+
+// ---------------------------------------------------------------------------
+// Kalyptra G0 additions: batch swap (many legs + matcher fees in ONE transaction)
+// ---------------------------------------------------------------------------
+
+/// One party's leg in a batch swap: sends `send_amount` of `send_asset` and
+/// receives `recv_amount` of `recv_asset`.
+#[derive(Clone, Copy)]
+pub struct SwapLeg {
+    pub account: u32,
+    pub send_amount: u64,
+    pub send_asset: AssetBase,
+    pub recv_amount: u64,
+    pub recv_asset: AssetBase,
+}
+
+/// Build ONE transaction that settles any number of legs plus a matcher that
+/// collects `fees`. Per asset, the total sent must equal the total received
+/// plus the fees; the function asserts this before building.
+pub fn create_batch_swap_transaction(
+    legs: &[SwapLeg],
+    matcher: u32,
+    fees: &[(AssetBase, u64)],
+    wallet: &mut User,
+) -> Transaction {
+    use std::collections::HashMap;
+    let mut net: HashMap<[u8; 32], i128> = HashMap::new();
+    for l in legs {
+        *net.entry(l.send_asset.to_bytes()).or_default() += l.send_amount as i128;
+        *net.entry(l.recv_asset.to_bytes()).or_default() -= l.recv_amount as i128;
+    }
+    for (a, f) in fees {
+        *net.entry(a.to_bytes()).or_default() -= *f as i128;
+    }
+    assert!(
+        net.values().all(|v| *v == 0),
+        "batch swap does not balance per asset"
+    );
+    info!(
+        "Batch swap: {} legs, {} fee assets, one transaction",
+        legs.len(),
+        fees.len()
+    );
+
+    let mut groups = Vec::new();
+    for l in legs {
+        groups.push(create_action_group(
+            l.account,
+            l.send_amount,
+            l.send_asset,
+            l.recv_amount,
+            l.recv_asset,
+            wallet,
+        ));
+    }
+    let fee_group = create_matcher_fee_action_group(matcher, fees, wallet);
+
+    let mut tx = create_tx(wallet);
+    for (ag, bsk) in groups {
+        tx.add_action_group::<FeeError>(ag, bsk).unwrap();
+    }
+    let (ag, bsk) = fee_group;
+    tx.add_action_group::<FeeError>(ag, bsk).unwrap();
+    build_tx(tx, &wallet.transparent_signing_set(), &[])
+}
+
+pub(crate) fn create_matcher_fee_action_group(
+    matcher_index: u32,
+    fees: &[(AssetBase, u64)],
+    wallet: &mut User,
+) -> (
+    Bundle<ActionGroupAuthorized, ZatBalance, OrchardZSA>,
+    SigningKey<Binding>,
+) {
+    let ovk = wallet.orchard_ovk(matcher_index);
+    let address = wallet.address_for_account(matcher_index, External);
+
+    let mut ag_builder =
+        orchard::builder::Builder::new(BundleType::DEFAULT_SWAP, wallet.orchard_anchor().unwrap());
+
+    for (asset, amount) in fees {
+        let reference_note = wallet.get_randomized_reference_note(*asset).unwrap();
+        ag_builder
+            .add_reference_note(
+                ReferenceKeys::fvk(),
+                reference_note.note,
+                reference_note.merkle_path,
+            )
+            .unwrap();
+        ag_builder
+            .add_output(
+                Some(ovk.clone()),
+                address,
+                NoteValue::from_raw(*amount),
+                *asset,
+                [0; 512],
+            )
+            .unwrap();
+    }
+
+    let (action_group, _) = ag_builder.build_action_group(OsRng, 10).unwrap();
+    let commitment = action_group.action_group_commitment().into();
+    action_group
+        .create_proof(
+            &orchard::circuit::ProvingKey::build::<OrchardZSA>(),
+            &mut OsRng,
+        )
+        .unwrap()
+        .apply_signatures_for_action_group(OsRng, commitment, &[])
+        .unwrap()
+}
+
+// ---------------------------------------------------------------------------
+// Kalyptra G0 additions: separate-keys flow. Each party builds ITS OWN action group
+// with ONLY its own wallet; the matcher wallet only assembles finished groups.
+// ---------------------------------------------------------------------------
+
+pub type PartyGroup = (
+    Bundle<ActionGroupAuthorized, ZatBalance, OrchardZSA>,
+    SigningKey<Binding>,
+);
+
+/// Run by a PARTY, with that party's wallet only (the only place its spending
+/// keys are used).
+pub fn party_build_leg(leg: SwapLeg, wallet: &mut User) -> PartyGroup {
+    create_action_group(
+        leg.account,
+        leg.send_amount,
+        leg.send_asset,
+        leg.recv_amount,
+        leg.recv_asset,
+        wallet,
+    )
+}
+
+/// Run by the MATCHER, with the matcher's wallet only: its own fee group.
+pub fn matcher_build_fee_group(fees: &[(AssetBase, u64)], matcher: u32, wallet: &mut User) -> PartyGroup {
+    create_matcher_fee_action_group(matcher, fees, wallet)
+}
+
+/// Run by the MATCHER: assemble finished groups from the parties into one
+/// transaction. Needs no party keys.
+pub fn matcher_assemble(groups: Vec<PartyGroup>, wallet: &User) -> Transaction {
+    let mut tx = create_tx(wallet);
+    for (ag, bsk) in groups {
+        tx.add_action_group::<FeeError>(ag, bsk).unwrap();
+    }
+    build_tx(tx, &wallet.transparent_signing_set(), &[])
+}
+
+/// Transfer to an address that belongs to ANOTHER wallet.
+pub fn create_transfer_to_address(
+    sender_index: u32,
+    recipient: Address,
+    amount: u64,
+    asset: AssetBase,
+    wallet: &mut User,
+) -> Transaction {
+    info!("Transfer {} units to an external address", amount);
+    let sender = wallet.address_for_account(sender_index, External);
+    let ovk = wallet.orchard_ovk(sender_index);
+    let inputs = wallet.select_spendable_notes(sender, amount, asset);
+    let total_inputs_amount = inputs.iter().fold(0, |acc, input| acc + input.note.value().inner());
+    let mut tx = create_tx(wallet);
+    let orchard_keys: Vec<SpendAuthorizingKey> = inputs
+        .into_iter()
+        .map(|input| {
+            tx.add_orchard_spend::<FeeError>((&input.sk).into(), input.note, input.merkle_path)
+                .unwrap();
+            SpendAuthorizingKey::from(&input.sk)
+        })
+        .collect();
+    tx.add_orchard_output::<FeeError>(Some(ovk.clone()), recipient, amount, asset, MemoBytes::empty())
+        .unwrap();
+    let change_amount = total_inputs_amount - amount;
+    if change_amount != 0 {
+        tx.add_orchard_output::<FeeError>(Some(ovk), sender, change_amount, asset, MemoBytes::empty())
+            .unwrap();
+    }
+    build_tx(tx, &wallet.transparent_signing_set(), orchard_keys.as_slice())
+}
