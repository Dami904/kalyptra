+//! Kalyptra G2: one persistent wallet per process, for settling sealed auction rounds.
+//!
+//! Every subcommand opens ONE wallet directory (`seed.txt` + `wallet.sqlite`), rescans the
+//! local regtest chain, does one thing, and prints one line `KALYPTRA_RESULT <json>` for the
+//! caller (the `kalyptra` binary) to parse. A party's spending keys are only ever used by the
+//! process that holds its wallet; what crosses process boundaries is a finished action
+//! group (`leg`), which the settlement leader checks and assembles (`assemble`).
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use crate::components::rpc_client::reqwest::ReqwestRpcClient;
+use crate::components::rpc_client::RpcClient;
+use crate::components::transactions::{
+    create_finalization_transaction, create_issue_transaction, create_transfer_to_address,
+    matcher_assemble, mine, party_build_leg, sync_from_height, SwapLeg,
+};
+use crate::components::user::User;
+use crate::components::kalyptra_wire::{group_moves_exactly, read_group, write_group};
+use crate::prelude::*;
+use abscissa_core::{Command, Runnable};
+use diesel::connection::SimpleConnection;
+use diesel::{Connection, SqliteConnection};
+use nonempty::NonEmpty;
+use orchard::issuance::compute_asset_desc_hash;
+use orchard::keys::FullViewingKey;
+use orchard::keys::Scope::External;
+use orchard::note::AssetBase;
+use orchard::Address;
+use serde::Deserialize;
+use zcash_primitives::block::BlockHash;
+
+/// Kalyptra settlement wallet commands
+#[derive(clap::Parser, Command, Debug)]
+pub struct KalyptraWalletCmd {
+    #[command(subcommand)]
+    op: Op,
+}
+
+#[derive(clap::Subcommand, Debug)]
+enum Op {
+    /// Create a wallet directory with a fresh random seed and an empty database.
+    Init {
+        #[arg(long)]
+        wallet: PathBuf,
+    },
+    /// Print the wallet's shielded address (raw, hex).
+    Address {
+        #[arg(long)]
+        wallet: PathBuf,
+    },
+    /// Print the wallet's balance of one asset.
+    Balance {
+        #[arg(long)]
+        wallet: PathBuf,
+        #[arg(long)]
+        asset: String,
+    },
+    /// Print the wallet's balance of several assets, from one scan of the chain.
+    Balances {
+        #[arg(long)]
+        wallet: PathBuf,
+        #[arg(long, num_args = 1..)]
+        asset: Vec<String>,
+    },
+    /// Issue a new asset to this wallet, and optionally finalize it (cap its supply).
+    Issue {
+        #[arg(long)]
+        wallet: PathBuf,
+        #[arg(long)]
+        name: String,
+        #[arg(long)]
+        amount: u64,
+        #[arg(long)]
+        finalize: bool,
+    },
+    /// Send an asset to another wallet's address and mine it.
+    Send {
+        #[arg(long)]
+        wallet: PathBuf,
+        #[arg(long)]
+        to: String,
+        #[arg(long)]
+        asset: String,
+        #[arg(long)]
+        amount: u64,
+    },
+    /// Build this wallet's own action group for one swap leg and write it to a file.
+    Leg {
+        #[arg(long)]
+        wallet: PathBuf,
+        #[arg(long)]
+        send_asset: String,
+        #[arg(long)]
+        send: u64,
+        #[arg(long)]
+        recv_asset: String,
+        #[arg(long)]
+        recv: u64,
+        #[arg(long)]
+        out: PathBuf,
+    },
+    /// Print this wallet's full viewing key (hex), to hand to an auditor. It reveals holdings
+    /// and history; it cannot spend.
+    ViewKey {
+        #[arg(long)]
+        wallet: PathBuf,
+    },
+    /// As an auditor, with the auditor's OWN wallet directory and only another wallet's viewing
+    /// key: report that wallet's balance of each asset.
+    Audit {
+        #[arg(long)]
+        wallet: PathBuf,
+        #[arg(long)]
+        fvk: String,
+        /// Asset ids (hex) to report.
+        #[arg(long, num_args = 1..)]
+        asset: Vec<String>,
+    },
+    /// Check finished groups against a settlement plan, assemble ONE transaction, mine it.
+    Assemble {
+        #[arg(long)]
+        wallet: PathBuf,
+        /// JSON: {"legs":[{"label","file","send_asset","send","recv_asset","recv"}]}
+        #[arg(long)]
+        plan: PathBuf,
+    },
+}
+
+#[derive(Deserialize)]
+struct PlanLeg {
+    label: String,
+    file: PathBuf,
+    send_asset: String,
+    send: u64,
+    recv_asset: String,
+    recv: u64,
+}
+
+#[derive(Deserialize)]
+struct Plan {
+    legs: Vec<PlanLeg>,
+}
+
+fn result(v: serde_json::Value) {
+    println!("KALYPTRA_RESULT {v}");
+}
+
+fn fail(msg: impl std::fmt::Display) -> ! {
+    result(serde_json::json!({ "ok": false, "error": msg.to_string() }));
+    std::process::exit(2)
+}
+
+fn asset(hex_str: &str) -> AssetBase {
+    let b: [u8; 32] = hex::decode(hex_str)
+        .ok()
+        .and_then(|v| v.try_into().ok())
+        .unwrap_or_else(|| fail(format!("bad asset id {hex_str}")));
+    Option::from(AssetBase::from_bytes(&b)).unwrap_or_else(|| fail("asset id is not a valid point"))
+}
+
+fn address(hex_str: &str) -> Address {
+    let b: [u8; 43] = hex::decode(hex_str)
+        .ok()
+        .and_then(|v| v.try_into().ok())
+        .unwrap_or_else(|| fail(format!("bad address {hex_str}")));
+    Option::from(Address::from_raw_address_bytes(&b)).unwrap_or_else(|| fail("bad address"))
+}
+
+fn rpc() -> ReqwestRpcClient {
+    ReqwestRpcClient::new(APP.config().network.node_url())
+}
+
+/// Open a wallet directory and rescan the chain into it.
+fn open(dir: &Path, rpc: &mut ReqwestRpcClient) -> User {
+    open_watching(dir, rpc, None).0
+}
+
+/// Open a wallet directory, optionally also watching another account through its viewing
+/// key, and rescan the chain. Returns the watched account's address, if any.
+fn open_watching(
+    dir: &Path,
+    rpc: &mut ReqwestRpcClient,
+    watch: Option<FullViewingKey>,
+) -> (User, Option<Address>) {
+    let dir = dir
+        .canonicalize()
+        .unwrap_or_else(|e| fail(format!("wallet {}: {e}", dir.display())));
+    let seed = std::fs::read_to_string(dir.join("seed.txt"))
+        .unwrap_or_else(|e| fail(format!("no seed in {}: {e}", dir.display())));
+    // The tool reads its database location from DATABASE_URL. The crate forbids unsafe
+    // code, so set it through dotenvy rather than std::env::set_var.
+    let env = dir.join("wallet.env");
+    std::fs::write(
+        &env,
+        format!("DATABASE_URL={}\n", dir.join("wallet.sqlite").display()),
+    )
+    .unwrap_or_else(|e| fail(e));
+    dotenvy::from_path_override(&env).unwrap_or_else(|e| fail(e));
+    let config = APP.config();
+    let mut w = User::new(&seed.trim().to_string(), &config.wallet.miner_seed_phrase);
+    w.reset();
+    // Deriving the address loads this wallet's keys into its in-memory key store. It must
+    // happen before the rescan, or the rescan cannot recognise the wallet's own notes.
+    my_address(&mut w);
+    let watched = watch.map(|fvk| w.watch(fvk));
+    sync_to_tip(config.chain.nu7_activation_height, &mut w, rpc);
+    (w, watched)
+}
+
+/// Rescan the chain, and make sure the scan reached the node's best block.
+///
+/// The tool's own scan stops at the first error it gets from the node as if it had reached the
+/// end of the chain. A node that misses one request (busy, restarting, briefly unreachable)
+/// would leave the wallet on part of the chain, and every balance would be answered wrongly
+/// (all zero, if the very first request failed) as a success. Here a scan that did not reach
+/// the best block is wiped and redone; if it still does not, the command fails and says why.
+fn sync_to_tip(from: u32, w: &mut User, rpc: &mut ReqwestRpcClient) {
+    const TRIES: u64 = 5;
+    for attempt in 1..=TRIES {
+        sync_from_height(from, w, rpc);
+        // The client returns `getbestblockhash` byte-reversed but `getblock` hashes (what the
+        // scan stores) as sent, so turn the best hash round before comparing them.
+        let best = rpc
+            .get_best_block_hash()
+            .map(|h| {
+                let mut b = h.0;
+                b.reverse();
+                BlockHash(b)
+            })
+            .map_err(|e| e.to_string());
+        // Only needed when nothing was scanned: is there a block to scan at all? A node that
+        // answers "no such block" has a chain that is still shorter than where scans start; a
+        // request that never reached the node says nothing.
+        let first = if w.last_block_hash().is_none() {
+            match rpc.get_block(from) {
+                Ok(_) => Ok(true),
+                Err(e) if e.downcast_ref::<reqwest::Error>().is_some() => Err(e.to_string()),
+                Err(_) => Ok(false),
+            }
+        } else {
+            Ok(true)
+        };
+        match tip_check(w.last_block_hash(), best, first) {
+            Ok(()) => return,
+            Err(why) if attempt == TRIES => fail(why),
+            Err(_) => {
+                // a clean rescan: resuming would scan the last block again and count its notes twice
+                w.reset();
+                std::thread::sleep(std::time::Duration::from_millis(400 * attempt));
+            }
+        }
+    }
+}
+
+/// The height of the block holding `txid`, among `blocks` (height, its transaction ids).
+fn height_of<I: Iterator<Item = (u32, Vec<zcash_primitives::transaction::TxId>)>>(
+    txid: &zcash_primitives::transaction::TxId,
+    blocks: I,
+) -> Option<u32> {
+    blocks
+        .into_iter()
+        .find(|(_, ids)| ids.contains(txid))
+        .map(|(h, _)| h)
+}
+
+/// Did the scan reach the chain's best block? `first_exists` says whether the chain has a block
+/// at the height scans start from (it may not yet, on a new chain).
+fn tip_check(
+    scanned_to: Option<BlockHash>,
+    best: Result<BlockHash, String>,
+    first_exists: Result<bool, String>,
+) -> Result<(), String> {
+    let unknown = |e: String| {
+        format!("the chain node does not answer, so this wallet's balances cannot be known: {e}")
+    };
+    let best = best.map_err(unknown)?;
+    match scanned_to {
+        Some(h) if h == best => Ok(()),
+        Some(h) => Err(format!(
+            "the wallet scanned only up to block {h}; the chain's best block is {best}"
+        )),
+        None => match first_exists.map_err(unknown)? {
+            false => Ok(()), // nothing to scan yet: the chain is shorter than where scans start
+            true => Err(format!(
+                "the wallet could not scan any block; the chain's best block is {best}"
+            )),
+        },
+    }
+}
+
+#[cfg(test)]
+mod tip_tests {
+    use super::*;
+    use zcash_primitives::transaction::TxId;
+
+    #[test]
+    fn a_settlement_already_in_a_block_is_found_not_resubmitted() {
+        let (a, b, c) = (TxId::from_bytes([1; 32]), TxId::from_bytes([2; 32]), TxId::from_bytes([3; 32]));
+        let chain = vec![(16, vec![a]), (15, vec![a, b]), (14, vec![a])];
+        assert_eq!(height_of(&b, chain.clone().into_iter()), Some(15));
+        assert_eq!(height_of(&c, chain.into_iter()), None);
+    }
+
+    fn h(b: u8) -> BlockHash {
+        BlockHash([b; 32])
+    }
+
+    #[test]
+    fn a_scan_that_reached_the_best_block_is_accepted() {
+        assert!(tip_check(Some(h(7)), Ok(h(7)), Ok(true)).is_ok());
+    }
+
+    #[test]
+    fn a_scan_that_stopped_early_is_refused_not_reported() {
+        let e = tip_check(Some(h(5)), Ok(h(7)), Ok(true)).unwrap_err();
+        assert!(e.contains("scanned only up to"), "{e}");
+    }
+
+    #[test]
+    fn a_scan_that_read_nothing_while_blocks_exist_is_refused() {
+        let e = tip_check(None, Ok(h(7)), Ok(true)).unwrap_err();
+        assert!(e.contains("could not scan"), "{e}");
+    }
+
+    #[test]
+    fn a_chain_too_short_to_scan_yet_is_fine() {
+        assert!(tip_check(None, Ok(h(7)), Ok(false)).is_ok());
+    }
+
+    #[test]
+    fn a_node_that_does_not_answer_is_an_error_not_a_zero_balance() {
+        let e = tip_check(Some(h(7)), Err("connection refused".into()), Ok(true)).unwrap_err();
+        assert!(e.contains("does not answer"), "{e}");
+        let e = tip_check(None, Ok(h(7)), Err("connection refused".into())).unwrap_err();
+        assert!(e.contains("does not answer"), "{e}");
+    }
+}
+
+fn my_address(w: &mut User) -> Address {
+    w.address_for_account(0, External)
+}
+
+impl Runnable for KalyptraWalletCmd {
+    fn run(&self) {
+        match &self.op {
+            Op::Init { wallet } => {
+                if wallet.join("seed.txt").exists() {
+                    fail(format!("{} already has a seed", wallet.display()));
+                }
+                std::fs::create_dir_all(wallet).unwrap_or_else(|e| fail(e));
+                let phrase = <bip0039::Mnemonic>::generate(bip0039::Count::Words24);
+                write_secret(&wallet.join("seed.txt"), phrase.phrase());
+                let db = wallet.join("wallet.sqlite");
+                let mut conn = SqliteConnection::establish(&db.display().to_string())
+                    .unwrap_or_else(|e| fail(e));
+                conn.batch_execute(include_str!("../../migrations/wallet_init/up.sql"))
+                    .unwrap_or_else(|e| fail(e));
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let a = my_address(&mut w);
+                result(serde_json::json!({ "ok": true, "address": hex::encode(a.to_raw_address_bytes()) }));
+            }
+            Op::Address { wallet } => {
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let a = my_address(&mut w);
+                result(serde_json::json!({ "ok": true, "address": hex::encode(a.to_raw_address_bytes()) }));
+            }
+            Op::Balance { wallet, asset: a } => {
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let addr = my_address(&mut w);
+                let bal = w.balance(addr, asset(a));
+                result(serde_json::json!({ "ok": true, "balance": bal }));
+            }
+            Op::Balances {
+                wallet,
+                asset: assets,
+            } => {
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let addr = my_address(&mut w);
+                let balances: serde_json::Map<String, serde_json::Value> = assets
+                    .iter()
+                    .map(|a| (a.clone(), serde_json::json!(w.balance(addr, asset(a)))))
+                    .collect();
+                result(serde_json::json!({ "ok": true, "balances": balances }));
+            }
+            Op::Issue {
+                wallet,
+                name,
+                amount,
+                finalize,
+            } => {
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let desc = NonEmpty::from_slice(name.as_bytes())
+                    .unwrap_or_else(|| fail("empty asset name"));
+                let desc_hash = compute_asset_desc_hash(&desc);
+                let addr = my_address(&mut w);
+                let (tx, issued) = create_issue_transaction(addr, *amount, desc_hash, true, &mut w);
+                mine(&mut w, &mut rpc, vec![tx]).unwrap_or_else(|e| fail(e));
+                if *finalize {
+                    let tx = create_finalization_transaction(desc_hash, &mut w);
+                    mine(&mut w, &mut rpc, vec![tx]).unwrap_or_else(|e| fail(e));
+                }
+                result(serde_json::json!({
+                    "ok": true,
+                    "asset": hex::encode(issued.to_bytes()),
+                    "finalized": finalize,
+                }));
+            }
+            Op::Send {
+                wallet,
+                to,
+                asset: a,
+                amount,
+            } => {
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let tx = create_transfer_to_address(0, address(to), *amount, asset(a), &mut w);
+                let txid = tx.txid();
+                mine(&mut w, &mut rpc, vec![tx]).unwrap_or_else(|e| fail(e));
+                result(serde_json::json!({ "ok": true, "txid": txid.to_string() }));
+            }
+            Op::Leg {
+                wallet,
+                send_asset,
+                send,
+                recv_asset,
+                recv,
+                out,
+            } => {
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let (sa, ra) = (asset(send_asset), asset(recv_asset));
+                let addr = my_address(&mut w);
+                if w.balance(addr, sa) < *send {
+                    fail(format!("this wallet holds less than {send} of the asset it must send"));
+                }
+                let (group, bsk) = party_build_leg(
+                    SwapLeg {
+                        account: 0,
+                        send_amount: *send,
+                        send_asset: sa,
+                        recv_amount: *recv,
+                        recv_asset: ra,
+                    },
+                    &mut w,
+                );
+                // Never hand over a group that does not match the agreed leg.
+                assert!(group_moves_exactly(&group, &bsk, sa, *send, ra, *recv));
+                let bytes = write_group(&group, &bsk).unwrap_or_else(|e| fail(e));
+                std::fs::write(out, &bytes).unwrap_or_else(|e| fail(e));
+                result(serde_json::json!({ "ok": true, "bytes": bytes.len() }));
+            }
+            Op::ViewKey { wallet } => {
+                let mut rpc = rpc();
+                let w = open(wallet, &mut rpc);
+                let fvk = w.full_viewing_key(0);
+                result(serde_json::json!({ "ok": true, "fvk": hex::encode(fvk.to_bytes()) }));
+            }
+            Op::Audit {
+                wallet,
+                fvk,
+                asset: assets,
+            } => {
+                let b: [u8; 96] = hex::decode(fvk)
+                    .ok()
+                    .and_then(|v| v.try_into().ok())
+                    .unwrap_or_else(|| fail("a viewing key is 96 bytes of hex"));
+                let fvk = FullViewingKey::from_bytes(&b).unwrap_or_else(|| fail("bad viewing key"));
+                let mut rpc = rpc();
+                let (mut w, watched) = open_watching(wallet, &mut rpc, Some(fvk));
+                let addr = watched.expect("watching");
+                let balances: serde_json::Map<String, serde_json::Value> = assets
+                    .iter()
+                    .map(|a| (a.clone(), serde_json::json!(w.balance(addr, asset(a)))))
+                    .collect();
+                result(serde_json::json!({
+                    "ok": true,
+                    "address": hex::encode(addr.to_raw_address_bytes()),
+                    "balances": balances,
+                }));
+            }
+            Op::Assemble { wallet, plan } => {
+                let plan: Plan = serde_json::from_slice(
+                    &std::fs::read(plan).unwrap_or_else(|e| fail(e)),
+                )
+                .unwrap_or_else(|e| fail(e));
+                if plan.legs.is_empty() {
+                    fail("empty plan");
+                }
+                // The plan itself must balance per asset.
+                let mut net: HashMap<[u8; 32], i128> = HashMap::new();
+                for l in &plan.legs {
+                    *net.entry(asset(&l.send_asset).to_bytes()).or_default() += l.send as i128;
+                    *net.entry(asset(&l.recv_asset).to_bytes()).or_default() -= l.recv as i128;
+                }
+                if net.values().any(|v| *v != 0) {
+                    fail("the plan does not balance per asset");
+                }
+                // Every group must move exactly its leg's amounts; name the ones that do not.
+                let mut groups = Vec::new();
+                let mut bad = Vec::new();
+                for l in &plan.legs {
+                    let parsed = std::fs::read(&l.file)
+                        .map_err(|e| e.to_string())
+                        .and_then(|b| read_group(&b).map_err(|e| e.to_string()));
+                    match parsed {
+                        Ok((g, bsk))
+                            if group_moves_exactly(
+                                &g,
+                                &bsk,
+                                asset(&l.send_asset),
+                                l.send,
+                                asset(&l.recv_asset),
+                                l.recv,
+                            ) =>
+                        {
+                            groups.push((g, bsk))
+                        }
+                        _ => bad.push(l.label.clone()),
+                    }
+                }
+                if !bad.is_empty() {
+                    result(serde_json::json!({ "ok": false, "error": "groups do not match their legs", "bad": bad }));
+                    std::process::exit(3);
+                }
+                let mut rpc = rpc();
+                let mut w = open(wallet, &mut rpc);
+                let tx = matcher_assemble(groups, &w);
+                let txid = tx.txid();
+                // Never submit a settlement the chain already has. The same parts give the same
+                // transaction, so a second node settling a round (a takeover after the leader went
+                // down, or a retry after an unknown outcome) would submit it again; this regtest
+                // node does not reject a block holding a transaction it already has, it crashes
+                // ("transactions must be unique within a single chain"). Report where it is.
+                // The node and the tool's block reader use the reversed byte order of `txid()`.
+                let on_chain_id = {
+                    let mut b = *txid.as_ref();
+                    b.reverse();
+                    zcash_primitives::transaction::TxId::from_bytes(b)
+                };
+                if rpc.get_transaction(&on_chain_id).is_ok() {
+                    let tip: u32 = w.last_block_height().map(u32::from).unwrap_or(0);
+                    let from = APP.config().chain.nu7_activation_height;
+                    let blocks = (from..=tip).rev().filter_map(|h| {
+                        rpc.get_block(h).ok().map(|b| (h, b.tx_ids))
+                    });
+                    match height_of(&on_chain_id, blocks) {
+                        Some(height) => {
+                            result(serde_json::json!({
+                                "ok": true, "txid": txid.to_string(), "height": height,
+                                "already_on_chain": true,
+                            }));
+                            return;
+                        }
+                        None => fail(format!(
+                            "settlement {txid} is already known to the node but in no block yet; not submitted again"
+                        )),
+                    }
+                }
+                mine(&mut w, &mut rpc, vec![tx])
+                    .unwrap_or_else(|e| fail(format!("the node rejected the settlement: {e}")));
+                let height: u32 = w.last_block_height().map(u32::from).unwrap_or(0);
+                result(serde_json::json!({ "ok": true, "txid": txid.to_string(), "height": height }));
+            }
+        }
+    }
+}
+
+fn write_secret(path: &Path, text: &str) {
+    std::fs::write(path, format!("{text}\n")).unwrap_or_else(|e| fail(e));
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))
+            .unwrap_or_else(|e| fail(e));
+    }
+}
diff --git a/src/commands/test_kalyptra_keys.rs b/src/commands/test_kalyptra_keys.rs
new file mode 100755
index 0000000..fc614d3
--- /dev/null
+++ b/src/commands/test_kalyptra_keys.rs
@@ -0,0 +1,189 @@
+//! Kalyptra G0: SEPARATE-KEYS swap flow.
+//!
+//! Six independent wallets, each with its own random seed AND its own database file:
+//! issuer, seller1, seller2, buyer1, buyer2, matcher. Each party builds only its own
+//! action group with only its own wallet. The matcher wallet receives finished groups
+//! and assembles ONE transaction. Then two attacks by the matcher are tried:
+//!   A. build a group for a party's assets without that party's keys -> must fail
+//!   B. take a bigger fee than the parties agreed -> must fail (build or node)
+
+use crate::components::rpc_client::reqwest::ReqwestRpcClient;
+use crate::components::transactions::{
+    create_issue_transaction, create_transfer_to_address, matcher_assemble,
+    matcher_build_fee_group, mine, mine_block, party_build_leg, sync, sync_from_height, SwapLeg,
+};
+use crate::components::user::User;
+use crate::prelude::*;
+use abscissa_core::{Command, Runnable};
+use nonempty::NonEmpty;
+use orchard::issuance::compute_asset_desc_hash;
+use orchard::keys::Scope::External;
+use orchard::note::AssetBase;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+/// Run the Kalyptra separate-keys swap test
+#[derive(clap::Parser, Command, Debug)]
+pub struct TestKalyptraKeysCmd {}
+
+fn wallet(name: &str, miner_seed: &String) -> User {
+    // each wallet gets its OWN database file, read when the wallet is created
+    // point DATABASE_URL at this wallet's own file (the crate forbids unsafe, so use dotenvy)
+    let envfile = format!("vk_{}.env", name);
+    std::fs::write(&envfile, format!("DATABASE_URL=vk_{}.sqlite
+", name)).unwrap();
+    dotenvy::from_path_override(&envfile).unwrap();
+    let mut w = User::random(miner_seed);
+    w.reset();
+    w
+}
+
+/// Try to build and mine a transaction. Returns true if it was stopped, either by a panic
+/// while building or by the node rejecting the block.
+fn chain_blocks(
+    rpc: &mut ReqwestRpcClient,
+    build: impl FnOnce() -> zcash_primitives::transaction::Transaction,
+) -> bool {
+    match catch_unwind(AssertUnwindSafe(build)) {
+        Err(_) => {
+            info!("  -> stopped while building");
+            true
+        }
+        Ok(tx) => match mine_block(rpc, vec![tx], false) {
+            Err(_) => {
+                info!("  -> stopped by the node (block rejected)");
+                true
+            }
+            Ok(_) => false,
+        },
+    }
+}
+
+fn bal(w: &mut User, asset: AssetBase) -> u64 {
+    let a = w.address_for_account(0, External);
+    w.balance(a, asset)
+}
+
+impl Runnable for TestKalyptraKeysCmd {
+    fn run(&self) {
+        let config = APP.config();
+        let mut rpc = ReqwestRpcClient::new(config.network.node_url());
+        let seed = &config.wallet.miner_seed_phrase;
+
+        let mut issuer = wallet("issuer", seed);
+        let mut s1 = wallet("s1", seed);
+        let mut s2 = wallet("s2", seed);
+        let mut b1 = wallet("b1", seed);
+        let mut b2 = wallet("b2", seed);
+        let mut m = wallet("m", seed);
+
+        let h = config.chain.nu7_activation_height;
+        sync_from_height(h, &mut issuer, &mut rpc);
+        sync_from_height(h, &mut s1, &mut rpc);
+        sync_from_height(h, &mut s2, &mut rpc);
+        sync_from_height(h, &mut b1, &mut rpc);
+        sync_from_height(h, &mut b2, &mut rpc);
+        sync_from_height(h, &mut m, &mut rpc);
+
+        macro_rules! sync_others {
+            () => {
+                sync(&mut s1, &mut rpc);
+                sync(&mut s2, &mut rpc);
+                sync(&mut b1, &mut rpc);
+                sync(&mut b2, &mut rpc);
+                sync(&mut m, &mut rpc);
+            };
+        }
+
+        // ----- issue ACME and vUSD (issuer only; the issuer also mines every block) -----
+        let e_hash = compute_asset_desc_hash(&NonEmpty::from_slice(b"ACME").unwrap());
+        let u_hash = compute_asset_desc_hash(&NonEmpty::from_slice(b"vUSD").unwrap());
+        let a0 = issuer.address_for_account(0, External);
+        let (tx, e) = create_issue_transaction(a0, 1000, e_hash, true, &mut issuer);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("mined");
+        sync_others!();
+        let a0 = issuer.address_for_account(0, External);
+        let (tx, u) = create_issue_transaction(a0, 100_000, u_hash, true, &mut issuer);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("mined");
+        sync_others!();
+
+        // ----- fund each party at ITS OWN wallet's address -----
+        let s1_addr = s1.address_for_account(0, External);
+        let s2_addr = s2.address_for_account(0, External);
+        let b1_addr = b1.address_for_account(0, External);
+        let b2_addr = b2.address_for_account(0, External);
+        for (addr, asset, amt) in [(s1_addr, e, 100u64), (s2_addr, e, 100), (b1_addr, u, 1000), (b2_addr, u, 1000)] {
+            let tx = create_transfer_to_address(0, addr, amt, asset, &mut issuer);
+            mine(&mut issuer, &mut rpc, vec![tx]).expect("mined");
+            sync_others!();
+        }
+        // each wallet sees ONLY its own holdings
+        assert_eq!(bal(&mut s1, e), 100);
+        assert_eq!(bal(&mut s2, e), 100);
+        assert_eq!(bal(&mut b1, u), 1000);
+        assert_eq!(bal(&mut b2, u), 1000);
+        assert_eq!(bal(&mut s1, u), 0);
+        assert_eq!(bal(&mut m, e), 0);
+        assert_eq!(bal(&mut m, u), 0);
+        info!("FUNDED: each wallet holds only its own assets (matcher holds none)");
+
+        // ===== ROUND 1: each party builds ITS OWN group; matcher only assembles =====
+        let g_s1 = party_build_leg(SwapLeg { account: 0, send_amount: 10, send_asset: e, recv_amount: 49, recv_asset: u }, &mut s1);
+        let g_s2 = party_build_leg(SwapLeg { account: 0, send_amount: 4, send_asset: e, recv_amount: 19, recv_asset: u }, &mut s2);
+        let g_b1 = party_build_leg(SwapLeg { account: 0, send_amount: 40, send_asset: u, recv_amount: 8, recv_asset: e }, &mut b1);
+        let g_b2 = party_build_leg(SwapLeg { account: 0, send_amount: 30, send_asset: u, recv_amount: 6, recv_asset: e }, &mut b2);
+        let g_m = matcher_build_fee_group(&[(u, 2)], 0, &mut m);
+        let tx = matcher_assemble(vec![g_s1, g_s2, g_b1, g_b2, g_m], &m);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("round 1 mined");
+        sync_others!();
+        assert_eq!(bal(&mut s1, e), 90);
+        assert_eq!(bal(&mut s1, u), 49);
+        assert_eq!(bal(&mut s2, e), 96);
+        assert_eq!(bal(&mut s2, u), 19);
+        assert_eq!(bal(&mut b1, e), 8);
+        assert_eq!(bal(&mut b1, u), 960);
+        assert_eq!(bal(&mut b2, e), 6);
+        assert_eq!(bal(&mut b2, u), 970);
+        assert_eq!(bal(&mut m, u), 2);
+        info!("ROUND 1 PASSED: separate wallets, one transaction, matcher took only its 2 vUSD fee");
+
+        // ===== ATTACK A: matcher tries to build a group that spends a seller's ACME =====
+        // It holds no ACME and none of the seller's keys. Blocked either while building the
+        // group, while building the transaction, or by the node rejecting the block.
+        let blocked_a = chain_blocks(&mut rpc, || {
+            let g = party_build_leg(SwapLeg { account: 0, send_amount: 10, send_asset: e, recv_amount: 49, recv_asset: u }, &mut m);
+            matcher_assemble(vec![g], &m)
+        });
+        assert!(blocked_a, "matcher spent ACME it does not hold and the chain accepted it!");
+        info!("ATTACK A BLOCKED: matcher cannot spend assets it does not hold");
+
+        // ===== ATTACK B: matcher takes a bigger fee (2) than the parties agreed (1) =====
+        let g_s1 = party_build_leg(SwapLeg { account: 0, send_amount: 3, send_asset: e, recv_amount: 14, recv_asset: u }, &mut s1);
+        let g_b2 = party_build_leg(SwapLeg { account: 0, send_amount: 15, send_asset: u, recv_amount: 3, recv_asset: e }, &mut b2);
+        let g_greedy = matcher_build_fee_group(&[(u, 2)], 0, &mut m); // parties agreed fee 1
+        let rejected = chain_blocks(&mut rpc, || matcher_assemble(vec![g_s1, g_b2, g_greedy], &m));
+        assert!(rejected, "matcher took an unagreed fee and the chain accepted it!");
+        info!("ATTACK B BLOCKED: an unagreed fee cannot be taken");
+        sync(&mut issuer, &mut rpc);
+        sync_others!();
+        // nothing moved
+        assert_eq!(bal(&mut s1, e), 90);
+        assert_eq!(bal(&mut b2, u), 970);
+        assert_eq!(bal(&mut m, u), 2);
+
+        // ===== RECOVERY: the honest version of that same round still works afterwards =====
+        let g_s1 = party_build_leg(SwapLeg { account: 0, send_amount: 3, send_asset: e, recv_amount: 14, recv_asset: u }, &mut s1);
+        let g_b2 = party_build_leg(SwapLeg { account: 0, send_amount: 15, send_asset: u, recv_amount: 3, recv_asset: e }, &mut b2);
+        let g_m = matcher_build_fee_group(&[(u, 1)], 0, &mut m);
+        let tx = matcher_assemble(vec![g_s1, g_b2, g_m], &m);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("recovery round mined");
+        sync_others!();
+        assert_eq!(bal(&mut s1, e), 87);
+        assert_eq!(bal(&mut s1, u), 63);
+        assert_eq!(bal(&mut b2, e), 9);
+        assert_eq!(bal(&mut b2, u), 955);
+        assert_eq!(bal(&mut m, u), 3);
+        info!("RECOVERY PASSED: honest round after the blocked attack");
+
+        info!("ALL SEPARATE-KEYS TESTS PASSED");
+    }
+}
diff --git a/src/commands/test_kalyptra_swaps.rs b/src/commands/test_kalyptra_swaps.rs
new file mode 100755
index 0000000..d483abe
--- /dev/null
+++ b/src/commands/test_kalyptra_swaps.rs
@@ -0,0 +1,131 @@
+//! Kalyptra G0 swap tests.
+//!
+//! 1. A whole auction round (2 sellers + 2 buyers at one clearing price) settles
+//!    in ONE transaction.
+//! 2. A different price and odd sizes (with change outputs) settle correctly.
+//! 3. The matcher account really receives the fees (checked by balances).
+//! 4. Fees can be taken in both assets at once.
+//!
+//! Accounts: 0 issuer, 1-2 sellers, 3-4 buyers, 5 matcher.
+//! Assets: ACME (equity), vUSD (quote).
+
+use crate::commands::test_balances::{check_balances, print_balances, TestBalances};
+use crate::components::rpc_client::reqwest::ReqwestRpcClient;
+use crate::components::transactions::{
+    create_batch_swap_transaction, create_issue_transaction, create_transfer_transaction, mine,
+    sync_from_height, SwapLeg,
+};
+use crate::components::user::User;
+use crate::prelude::*;
+use abscissa_core::{Command, Runnable};
+use nonempty::NonEmpty;
+use orchard::issuance::compute_asset_desc_hash;
+use orchard::keys::Scope::External;
+
+/// Run the Kalyptra swap tests
+#[derive(clap::Parser, Command, Debug)]
+pub struct TestKalyptraSwapsCmd {}
+
+impl Runnable for TestKalyptraSwapsCmd {
+    fn run(&self) {
+        let config = APP.config();
+        let mut rpc = ReqwestRpcClient::new(config.network.node_url());
+        let mut st = User::random(&config.wallet.miner_seed_phrase);
+        st.reset();
+
+        let n: u32 = 6;
+        let (issuer, s1, s2, b1, b2, m) = (0u32, 1u32, 2u32, 3u32, 4u32, 5u32);
+
+        sync_from_height(config.chain.nu7_activation_height, &mut st, &mut rpc);
+
+        // ----------------------------- issue two assets -----------------------------
+        let e_hash = compute_asset_desc_hash(&NonEmpty::from_slice(b"ACME").unwrap());
+        let u_hash = compute_asset_desc_hash(&NonEmpty::from_slice(b"vUSD").unwrap());
+
+        let addr = st.address_for_account(issuer, External);
+        let (tx, e) = create_issue_transaction(addr, 1000, e_hash, true, &mut st);
+        mine(&mut st, &mut rpc, vec![tx]).expect("mined");
+        let addr = st.address_for_account(issuer, External);
+        let (tx, u) = create_issue_transaction(addr, 100_000, u_hash, true, &mut st);
+        mine(&mut st, &mut rpc, vec![tx]).expect("mined");
+
+        // ----------------------------- fund the investors ----------------------------
+        for (to, asset, amount) in [(s1, e, 100u64), (s2, e, 100), (b1, u, 1000), (b2, u, 1000)] {
+            let tx = create_transfer_transaction(issuer, to, amount, asset, &mut st);
+            mine(&mut st, &mut rpc, vec![tx]).expect("mined");
+        }
+
+        let mut exp_e = TestBalances::get_asset_balances(e, n, &mut st);
+        let mut exp_u = TestBalances::get_asset_balances(u, n, &mut st);
+        print_balances("=== ACME after funding ===", e, n, &mut st);
+        print_balances("=== vUSD after funding ===", u, n, &mut st);
+        check_balances(e, &exp_e, &mut st, n);
+        check_balances(u, &exp_u, &mut st, n);
+
+        // ---------- TEST 1: one auction round, 2 sellers + 2 buyers, price 5, ONE tx ----------
+        // sellers: s1 sells 10 ACME, s2 sells 4 ACME. buyers: b1 buys 8, b2 buys 6.
+        // Total ACME sent 14 = received 14. vUSD: buyers send 40+30=70; sellers receive
+        // (50-1)+(20-1)=68; the matcher keeps 2.
+        let legs = [
+            SwapLeg { account: s1, send_amount: 10, send_asset: e, recv_amount: 49, recv_asset: u },
+            SwapLeg { account: s2, send_amount: 4, send_asset: e, recv_amount: 19, recv_asset: u },
+            SwapLeg { account: b1, send_amount: 40, send_asset: u, recv_amount: 8, recv_asset: e },
+            SwapLeg { account: b2, send_amount: 30, send_asset: u, recv_amount: 6, recv_asset: e },
+        ];
+        let tx = create_batch_swap_transaction(&legs, m, &[(u, 2)], &mut st);
+        mine(&mut st, &mut rpc, vec![tx]).expect("round 1 mined");
+        exp_e.decrement(s1, 10);
+        exp_e.decrement(s2, 4);
+        exp_e.increment(b1, 8);
+        exp_e.increment(b2, 6);
+        exp_u.increment(s1, 49);
+        exp_u.increment(s2, 19);
+        exp_u.decrement(b1, 40);
+        exp_u.decrement(b2, 30);
+        exp_u.increment(m, 2);
+        check_balances(e, &exp_e, &mut st, n);
+        check_balances(u, &exp_u, &mut st, n);
+        print_balances("=== TEST 1 (4-leg round, one tx): ACME ===", e, n, &mut st);
+        print_balances("=== TEST 1 (4-leg round, one tx): vUSD ===", u, n, &mut st);
+
+        // ---------- TEST 2: different price (3), odd size (7), uses change outputs ----------
+        // s1 sells 7 ACME to b2 at price 3: b2 sends 21 vUSD, s1 receives 19, matcher keeps 2.
+        let legs = [
+            SwapLeg { account: s1, send_amount: 7, send_asset: e, recv_amount: 19, recv_asset: u },
+            SwapLeg { account: b2, send_amount: 21, send_asset: u, recv_amount: 7, recv_asset: e },
+        ];
+        let tx = create_batch_swap_transaction(&legs, m, &[(u, 2)], &mut st);
+        mine(&mut st, &mut rpc, vec![tx]).expect("test 2 mined");
+        exp_e.decrement(s1, 7);
+        exp_e.increment(b2, 7);
+        exp_u.increment(s1, 19);
+        exp_u.decrement(b2, 21);
+        exp_u.increment(m, 2);
+        check_balances(e, &exp_e, &mut st, n);
+        check_balances(u, &exp_u, &mut st, n);
+        print_balances("=== TEST 2 (price 3, size 7): ACME ===", e, n, &mut st);
+        print_balances("=== TEST 2 (price 3, size 7): vUSD ===", u, n, &mut st);
+
+        // ---------- TEST 4: fees in BOTH assets (matcher collects ACME and vUSD) ----------
+        // s2 sells 5 ACME, receives 14 vUSD. b1 sends 15 vUSD, receives 4 ACME.
+        // ACME: 5 = 4 + fee 1. vUSD: 15 = 14 + fee 1.
+        let legs = [
+            SwapLeg { account: s2, send_amount: 5, send_asset: e, recv_amount: 14, recv_asset: u },
+            SwapLeg { account: b1, send_amount: 15, send_asset: u, recv_amount: 4, recv_asset: e },
+        ];
+        let tx = create_batch_swap_transaction(&legs, m, &[(e, 1), (u, 1)], &mut st);
+        mine(&mut st, &mut rpc, vec![tx]).expect("test 4 mined");
+        exp_e.decrement(s2, 5);
+        exp_e.increment(b1, 4);
+        exp_e.increment(m, 1);
+        exp_u.increment(s2, 14);
+        exp_u.decrement(b1, 15);
+        exp_u.increment(m, 1);
+        check_balances(e, &exp_e, &mut st, n);
+        check_balances(u, &exp_u, &mut st, n);
+        print_balances("=== TEST 4 (fees in both assets): ACME ===", e, n, &mut st);
+        print_balances("=== TEST 4 (fees in both assets): vUSD ===", u, n, &mut st);
+
+        info!("ALL KALYPTRA SWAP TESTS PASSED");
+    }
+}
