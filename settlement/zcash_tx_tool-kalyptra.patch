diff --git a/src/components/kalyptra_wire.rs b/src/components/kalyptra_wire.rs
new file mode 100755
index 0000000..0ac9eea
--- /dev/null
+++ b/src/components/kalyptra_wire.rs
@@ -0,0 +1,138 @@
+//! Kalyptra G2: move one party's action group between processes, and check its amounts.
+//!
+//! The action-group layout is the one QEDIT's librustzcash uses inside a swap
+//! transaction (`write_action_group` / `read_action_group_data`, which are private there),
+//! rebuilt here from that crate's public helpers. A group file adds the group's value
+//! balance and its binding signing key, which the assembler needs to sign the transaction.
+
+use std::io::{self, Read, Write};
+
+use nonempty::NonEmpty;
+use orchard::bundle::Authorization;
+use orchard::note::AssetBase;
+use orchard::orchard_flavor::OrchardZSA;
+use orchard::primitives::redpallas::{Binding, SigningKey};
+use orchard::swap_bundle::ActionGroupAuthorized;
+use orchard::value::{NoteValue, ValueCommitTrapdoor, ValueCommitment};
+use orchard::{Bundle, Proof};
+use zcash_encoding::{Array, Vector};
+use zcash_primitives::transaction::components::orchard::{
+    read_action_without_auth, read_anchor, read_burn, read_flags, read_versioned_signature,
+    write_action_without_auth, write_burn, write_versioned_signature,
+};
+use zcash_protocol::value::ZatBalance;
+
+pub type Group = Bundle<ActionGroupAuthorized, ZatBalance, OrchardZSA>;
+
+const MAGIC: &[u8; 4] = b"KLG1";
+
+/// Serialize a finished action group and its binding signing key.
+pub fn write_group(group: &Group, bsk: &SigningKey<Binding>) -> io::Result<Vec<u8>> {
+    let mut w = Vec::new();
+    w.write_all(MAGIC)?;
+    w.write_all(&i64::from(*group.value_balance()).to_le_bytes())?;
+    w.write_all(&<[u8; 32]>::from(*bsk))?;
+    Vector::write_nonempty(&mut w, group.actions(), |w, a| {
+        write_action_without_auth(w, a)
+    })?;
+    w.write_all(&[group.flags().to_byte()])?;
+    w.write_all(&group.anchor().to_bytes())?;
+    w.write_all(&group.expiry_height().to_le_bytes())?;
+    write_burn(&mut w, group.burn())?;
+    Vector::write(
+        &mut w,
+        group.authorization().proof().expect("group has a proof").as_ref(),
+        |w, b| w.write_all(&[*b]),
+    )?;
+    Array::write(
+        &mut w,
+        group.actions().iter().map(|a| a.authorization()),
+        |w, sig| write_versioned_signature(w, sig),
+    )?;
+    Ok(w)
+}
+
+fn bad(msg: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, msg.to_string())
+}
+
+/// Parse a group file written by [`write_group`]. Rejects trailing bytes.
+pub fn read_group(bytes: &[u8]) -> io::Result<(Group, SigningKey<Binding>)> {
+    let mut r = bytes;
+    let mut magic = [0u8; 4];
+    r.read_exact(&mut magic)?;
+    if &magic != MAGIC {
+        return Err(bad("not a Kalyptra action-group file"));
+    }
+    let mut vb = [0u8; 8];
+    r.read_exact(&mut vb)?;
+    let value_balance =
+        ZatBalance::from_i64(i64::from_le_bytes(vb)).map_err(|_| bad("bad value balance"))?;
+    let mut sk = [0u8; 32];
+    r.read_exact(&mut sk)?;
+    let bsk = SigningKey::<Binding>::try_from(sk).map_err(|_| bad("bad binding key"))?;
+
+    let actions_without_auth = Vector::read(&mut r, |r| read_action_without_auth(r))?;
+    if actions_without_auth.is_empty() {
+        return Err(bad("an action group needs at least one action"));
+    }
+    let flags = read_flags(&mut r)?;
+    let anchor = read_anchor(&mut r)?;
+    let mut t = [0u8; 4];
+    r.read_exact(&mut t)?;
+    let timelimit = u32::from_le_bytes(t);
+    let burn = read_burn(&mut r)?;
+    let proof = Proof::new(Vector::read(&mut r, |r| {
+        let mut b = [0u8; 1];
+        r.read_exact(&mut b)?;
+        Ok(b[0])
+    })?);
+    let actions = actions_without_auth
+        .into_iter()
+        .map(|a| a.try_map(|_| read_versioned_signature::<_, _>(&mut r)))
+        .collect::<Result<Vec<_>, _>>()?;
+    let actions = NonEmpty::from_vec(actions).ok_or_else(|| bad("no actions"))?;
+    if !r.is_empty() {
+        return Err(bad("trailing bytes after the action group"));
+    }
+    let group = Bundle::from_parts(
+        actions,
+        flags,
+        value_balance,
+        burn,
+        anchor,
+        timelimit,
+        ActionGroupAuthorized::from_parts(proof),
+    );
+    Ok((group, bsk))
+}
+
+/// True if the group moves exactly `send` of `send_asset` out of its owner's notes and
+/// exactly `recv` of `recv_asset` into them, and nothing else.
+///
+/// The value commitments of a group sum to `[v_a]V_a` over each asset `a` plus
+/// `[bsk]R`. Whoever holds the binding key can therefore check the net amounts per asset
+/// without seeing a single note. This lets the assembler name the party whose group is
+/// wrong, instead of finding out only when the node rejects the whole transaction.
+pub fn group_moves_exactly(
+    group: &Group,
+    bsk: &SigningKey<Binding>,
+    send_asset: AssetBase,
+    send: u64,
+    recv_asset: AssetBase,
+    recv: u64,
+) -> bool {
+    let zero = || NoteValue::from_raw(0);
+    let no_trapdoor = || ValueCommitTrapdoor::from_bytes([0u8; 32]).unwrap();
+    let sum: ValueCommitment = group.actions().iter().map(|a| a.cv_net().clone()).sum();
+    let rcv = match Option::<ValueCommitTrapdoor>::from(ValueCommitTrapdoor::from_bytes(
+        <[u8; 32]>::from(*bsk),
+    )) {
+        Some(r) => r,
+        None => return false,
+    };
+    let expected = ValueCommitment::derive(NoteValue::from_raw(send) - zero(), no_trapdoor(), send_asset)
+        + &ValueCommitment::derive(zero() - NoteValue::from_raw(recv), no_trapdoor(), recv_asset)
+        + &ValueCommitment::derive(zero() - zero(), rcv, AssetBase::native());
+    sum.to_bytes() == expected.to_bytes()
+}
