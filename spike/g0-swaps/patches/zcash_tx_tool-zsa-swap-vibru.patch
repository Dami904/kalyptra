diff --git a/src/commands/test_vibru_keys.rs b/src/commands/test_vibru_keys.rs
new file mode 100755
index 0000000..832816c
--- /dev/null
+++ b/src/commands/test_vibru_keys.rs
@@ -0,0 +1,189 @@
+//! Vibru G0: SEPARATE-KEYS swap flow.
+//!
+//! Six independent wallets, each with its own random seed AND its own database file:
+//! issuer, seller1, seller2, buyer1, buyer2, matcher. Each party builds only its own
+//! action group with only its own wallet. The matcher wallet receives finished groups
+//! and assembles ONE transaction. Then two attacks by the matcher are tried:
+//!   A. build a group for a party's assets without that party's keys -> must fail
+//!   B. take a bigger fee than the parties agreed -> must fail (build or node)
+
+use crate::components::rpc_client::reqwest::ReqwestRpcClient;
+use crate::components::transactions::{
+    create_issue_transaction, create_transfer_to_address, matcher_assemble,
+    matcher_build_fee_group, mine, mine_block, party_build_leg, sync, sync_from_height, SwapLeg,
+};
+use crate::components::user::User;
+use crate::prelude::*;
+use abscissa_core::{Command, Runnable};
+use nonempty::NonEmpty;
+use orchard::issuance::compute_asset_desc_hash;
+use orchard::keys::Scope::External;
+use orchard::note::AssetBase;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+/// Run the Vibru separate-keys swap test
+#[derive(clap::Parser, Command, Debug)]
+pub struct TestVibruKeysCmd {}
+
+fn wallet(name: &str, miner_seed: &String) -> User {
+    // each wallet gets its OWN database file, read when the wallet is created
+    // point DATABASE_URL at this wallet's own file (the crate forbids unsafe, so use dotenvy)
+    let envfile = format!("vk_{}.env", name);
+    std::fs::write(&envfile, format!("DATABASE_URL=vk_{}.sqlite
+", name)).unwrap();
+    dotenvy::from_path_override(&envfile).unwrap();
+    let mut w = User::random(miner_seed);
+    w.reset();
+    w
+}
+
+/// Try to build and mine a transaction. Returns true if it was stopped, either by a panic
+/// while building or by the node rejecting the block.
+fn chain_blocks(
+    rpc: &mut ReqwestRpcClient,
+    build: impl FnOnce() -> zcash_primitives::transaction::Transaction,
+) -> bool {
+    match catch_unwind(AssertUnwindSafe(build)) {
+        Err(_) => {
+            info!("  -> stopped while building");
+            true
+        }
+        Ok(tx) => match mine_block(rpc, vec![tx], false) {
+            Err(_) => {
+                info!("  -> stopped by the node (block rejected)");
+                true
+            }
+            Ok(_) => false,
+        },
+    }
+}
+
+fn bal(w: &mut User, asset: AssetBase) -> u64 {
+    let a = w.address_for_account(0, External);
+    w.balance(a, asset)
+}
+
+impl Runnable for TestVibruKeysCmd {
+    fn run(&self) {
+        let config = APP.config();
+        let mut rpc = ReqwestRpcClient::new(config.network.node_url());
+        let seed = &config.wallet.miner_seed_phrase;
+
+        let mut issuer = wallet("issuer", seed);
+        let mut s1 = wallet("s1", seed);
+        let mut s2 = wallet("s2", seed);
+        let mut b1 = wallet("b1", seed);
+        let mut b2 = wallet("b2", seed);
+        let mut m = wallet("m", seed);
+
+        let h = config.chain.nu7_activation_height;
+        sync_from_height(h, &mut issuer, &mut rpc);
+        sync_from_height(h, &mut s1, &mut rpc);
+        sync_from_height(h, &mut s2, &mut rpc);
+        sync_from_height(h, &mut b1, &mut rpc);
+        sync_from_height(h, &mut b2, &mut rpc);
+        sync_from_height(h, &mut m, &mut rpc);
+
+        macro_rules! sync_others {
+            () => {
+                sync(&mut s1, &mut rpc);
+                sync(&mut s2, &mut rpc);
+                sync(&mut b1, &mut rpc);
+                sync(&mut b2, &mut rpc);
+                sync(&mut m, &mut rpc);
+            };
+        }
+
+        // ----- issue ACME and vUSD (issuer only; the issuer also mines every block) -----
+        let e_hash = compute_asset_desc_hash(&NonEmpty::from_slice(b"ACME").unwrap());
+        let u_hash = compute_asset_desc_hash(&NonEmpty::from_slice(b"vUSD").unwrap());
+        let a0 = issuer.address_for_account(0, External);
+        let (tx, e) = create_issue_transaction(a0, 1000, e_hash, true, &mut issuer);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("mined");
+        sync_others!();
+        let a0 = issuer.address_for_account(0, External);
+        let (tx, u) = create_issue_transaction(a0, 100_000, u_hash, true, &mut issuer);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("mined");
+        sync_others!();
+
+        // ----- fund each party at ITS OWN wallet's address -----
+        let s1_addr = s1.address_for_account(0, External);
+        let s2_addr = s2.address_for_account(0, External);
+        let b1_addr = b1.address_for_account(0, External);
+        let b2_addr = b2.address_for_account(0, External);
+        for (addr, asset, amt) in [(s1_addr, e, 100u64), (s2_addr, e, 100), (b1_addr, u, 1000), (b2_addr, u, 1000)] {
+            let tx = create_transfer_to_address(0, addr, amt, asset, &mut issuer);
+            mine(&mut issuer, &mut rpc, vec![tx]).expect("mined");
+            sync_others!();
+        }
+        // each wallet sees ONLY its own holdings
+        assert_eq!(bal(&mut s1, e), 100);
+        assert_eq!(bal(&mut s2, e), 100);
+        assert_eq!(bal(&mut b1, u), 1000);
+        assert_eq!(bal(&mut b2, u), 1000);
+        assert_eq!(bal(&mut s1, u), 0);
+        assert_eq!(bal(&mut m, e), 0);
+        assert_eq!(bal(&mut m, u), 0);
+        info!("FUNDED: each wallet holds only its own assets (matcher holds none)");
+
+        // ===== ROUND 1: each party builds ITS OWN group; matcher only assembles =====
+        let g_s1 = party_build_leg(SwapLeg { account: 0, send_amount: 10, send_asset: e, recv_amount: 49, recv_asset: u }, &mut s1);
+        let g_s2 = party_build_leg(SwapLeg { account: 0, send_amount: 4, send_asset: e, recv_amount: 19, recv_asset: u }, &mut s2);
+        let g_b1 = party_build_leg(SwapLeg { account: 0, send_amount: 40, send_asset: u, recv_amount: 8, recv_asset: e }, &mut b1);
+        let g_b2 = party_build_leg(SwapLeg { account: 0, send_amount: 30, send_asset: u, recv_amount: 6, recv_asset: e }, &mut b2);
+        let g_m = matcher_build_fee_group(&[(u, 2)], 0, &mut m);
+        let tx = matcher_assemble(vec![g_s1, g_s2, g_b1, g_b2, g_m], &m);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("round 1 mined");
+        sync_others!();
+        assert_eq!(bal(&mut s1, e), 90);
+        assert_eq!(bal(&mut s1, u), 49);
+        assert_eq!(bal(&mut s2, e), 96);
+        assert_eq!(bal(&mut s2, u), 19);
+        assert_eq!(bal(&mut b1, e), 8);
+        assert_eq!(bal(&mut b1, u), 960);
+        assert_eq!(bal(&mut b2, e), 6);
+        assert_eq!(bal(&mut b2, u), 970);
+        assert_eq!(bal(&mut m, u), 2);
+        info!("ROUND 1 PASSED: separate wallets, one transaction, matcher took only its 2 vUSD fee");
+
+        // ===== ATTACK A: matcher tries to build a group that spends a seller's ACME =====
+        // It holds no ACME and none of the seller's keys. Blocked either while building the
+        // group, while building the transaction, or by the node rejecting the block.
+        let blocked_a = chain_blocks(&mut rpc, || {
+            let g = party_build_leg(SwapLeg { account: 0, send_amount: 10, send_asset: e, recv_amount: 49, recv_asset: u }, &mut m);
+            matcher_assemble(vec![g], &m)
+        });
+        assert!(blocked_a, "matcher spent ACME it does not hold and the chain accepted it!");
+        info!("ATTACK A BLOCKED: matcher cannot spend assets it does not hold");
+
+        // ===== ATTACK B: matcher takes a bigger fee (2) than the parties agreed (1) =====
+        let g_s1 = party_build_leg(SwapLeg { account: 0, send_amount: 3, send_asset: e, recv_amount: 14, recv_asset: u }, &mut s1);
+        let g_b2 = party_build_leg(SwapLeg { account: 0, send_amount: 15, send_asset: u, recv_amount: 3, recv_asset: e }, &mut b2);
+        let g_greedy = matcher_build_fee_group(&[(u, 2)], 0, &mut m); // parties agreed fee 1
+        let rejected = chain_blocks(&mut rpc, || matcher_assemble(vec![g_s1, g_b2, g_greedy], &m));
+        assert!(rejected, "matcher took an unagreed fee and the chain accepted it!");
+        info!("ATTACK B BLOCKED: an unagreed fee cannot be taken");
+        sync(&mut issuer, &mut rpc);
+        sync_others!();
+        // nothing moved
+        assert_eq!(bal(&mut s1, e), 90);
+        assert_eq!(bal(&mut b2, u), 970);
+        assert_eq!(bal(&mut m, u), 2);
+
+        // ===== RECOVERY: the honest version of that same round still works afterwards =====
+        let g_s1 = party_build_leg(SwapLeg { account: 0, send_amount: 3, send_asset: e, recv_amount: 14, recv_asset: u }, &mut s1);
+        let g_b2 = party_build_leg(SwapLeg { account: 0, send_amount: 15, send_asset: u, recv_amount: 3, recv_asset: e }, &mut b2);
+        let g_m = matcher_build_fee_group(&[(u, 1)], 0, &mut m);
+        let tx = matcher_assemble(vec![g_s1, g_b2, g_m], &m);
+        mine(&mut issuer, &mut rpc, vec![tx]).expect("recovery round mined");
+        sync_others!();
+        assert_eq!(bal(&mut s1, e), 87);
+        assert_eq!(bal(&mut s1, u), 63);
+        assert_eq!(bal(&mut b2, e), 9);
+        assert_eq!(bal(&mut b2, u), 955);
+        assert_eq!(bal(&mut m, u), 3);
+        info!("RECOVERY PASSED: honest round after the blocked attack");
+
+        info!("ALL SEPARATE-KEYS TESTS PASSED");
+    }
+}
diff --git a/src/commands/test_vibru_swaps.rs b/src/commands/test_vibru_swaps.rs
